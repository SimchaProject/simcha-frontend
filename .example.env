# Backend API base URL. Defaults to http://localhost:3000 in dev (see
# src/api/http.ts) - only needs setting in production, to the deployed
# backend's URL (e.g. https://simcha-backend.onrender.com). Baked in at
# build time by Vite, so set it in Vercel's project env vars, not here.
VITE_API_BASE_URL=
